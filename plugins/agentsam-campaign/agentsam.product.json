{
  "schema": "agentsam.plugin-product/v1",
  "identity": {
    "id": "agentsam-campaign",
    "version": "1.0.0",
    "publisher": "Inner Animal Media"
  },
  "ownership": {
    "domainPackage": "@inneranimalmedia/agentsam-campaign",
    "owns": [
      "campaign intelligence",
      "campaign schemas",
      "campaign policy",
      "campaign presentation"
    ],
    "platformAuthorities": [
      "identity.oauth",
      "vault.credentials",
      "settings.plugin-installation",
      "plugin-runtime.mcp",
      "hooks.mcp-adaptation",
      "capability.runtime",
      "repository.evidence",
      "machine.perception",
      "plugin-runtime.health",
      "plugin-runtime.receipts",
      "plugin-runtime.retry"
    ]
  },
  "resources": [
    "campaign.context",
    "campaign.brief",
    "campaign.concept",
    "campaign.plan",
    "brand.context"
  ],
  "capabilities": [
    {
      "id": "campaign.get_context",
      "risk": "read",
      "permissions": [
        "campaign:read"
      ]
    },
    {
      "id": "campaign.brief.draft",
      "risk": "prepare",
      "permissions": [
        "campaign:read"
      ]
    },
    {
      "id": "campaign.concept.evaluate",
      "risk": "read",
      "permissions": [
        "campaign:read"
      ]
    },
    {
      "id": "campaign.concepts.rank",
      "risk": "read",
      "permissions": [
        "campaign:read"
      ]
    },
    {
      "id": "campaign.plan",
      "risk": "prepare",
      "permissions": [
        "campaign:read"
      ]
    },
    {
      "id": "campaign.brief.save",
      "risk": "write",
      "permissions": [
        "campaign:brief:write"
      ]
    },
    {
      "id": "campaign.concept.save",
      "risk": "write",
      "permissions": [
        "campaign:concept:write"
      ]
    }
  ],
  "permissions": {
    "declared": [
      "campaign:brief:write",
      "campaign:concept:write",
      "campaign:read"
    ]
  },
  "auth": {
    "type": "oauth",
    "connectionRequired": true,
    "resource": "https://plugins.inneranimalmedia.com/mcp"
  },
  "health": {
    "required": true,
    "strategy": "mcp.tools_list"
  },
  "lifecycle": {
    "states": [
      "available",
      "installed",
      "needs_connection",
      "connected",
      "ready"
    ]
  },
  "verification": {
    "requiredChecks": [
      "definition.manifest",
      "package.resolve",
      "installation.catalog",
      "installation.account",
      "authorization.valid",
      "authorization.permissions",
      "runtime.mcp_reachable",
      "runtime.capabilities_discovered",
      "runtime.tools_executable",
      "health.probe",
      "product.smoke",
      "product.result_schema",
      "product.render",
      "persistence.round_trip",
      "security.least_privilege",
      "security.tenant_isolation",
      "portability.fresh_account",
      "portability.fresh_install"
    ]
  },
  "release": {
    "receiptRequired": true
  }
}
