{
  "name": "@inneranimalmedia/agentsam-plugin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public least-privilege MCP capability plane for installable AgentSam plugins.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "test:evals": "node test/evals/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:evals && npm run verify:plugins",
    "verify:plugins": "node scripts/verify-plugin-packages.mjs"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-brand": "^2.6.11",
    "@inneranimalmedia/agentsam-campaign": "^2.6.11",
    "@inneranimalmedia/agentsam-errors": "^2.6.11",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "hono": "^4.0.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
