{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentsam-plugin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsam",
      "database_id": "455232e0-1726-4bd0-a03a-d0d25f6c4180",
      "migrations_dir": "migrations/d1"
    }
  ],
  "vars": {
    "SERVICE_NAME": "agentsam-plugin-mcp",
    "SERVICE_ENV": "production",
    "SERVICE_VERSION": "0.2.1",
    "AGENTSAM_PUBLIC_BASE_URL": "https://agentsam-plugin-mcp.meauxbility.workers.dev",
    "AGENTSAM_PUBLIC_ISSUER": "https://inneranimalmedia.com",
    "AGENTSAM_PUBLIC_AUDIENCE": "https://agentsam-plugin-mcp.meauxbility.workers.dev/mcp",
    "AGENTSAM_PUBLIC_USERINFO_URL": "https://inneranimalmedia.com/api/oauth/userinfo"
  }
}
